# HD Agent — انسخ إلى .env واملأ القيم. لا ترفع .env أبداً.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hdagent
# python -m scripts.gen_keys
ENCRYPTION_KEY=
JWT_SECRET=
# الذكاء الاصطناعي
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
ANTHROPIC_WORKSPACE_ID=
# أول حساب للوحة التحكم
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=ChangeMe-Strong123
ADMIN_PANEL_PATH=/panel-change-me
PUBLIC_URL=https://your-app.up.railway.app
PORT=8080
COOKIE_SECURE=true
SESSION_HOURS=12
# (اختياري) بوت تيليجرام للإرسال فقط لإشعار الإدارة + OWNER_TELEGRAM_IDS
NOTIFY_BOT_TOKEN=
OWNER_TELEGRAM_IDS=
REQUIRE_TELEGRAM_CODE=false
BACKUP_EVERY_HOURS=24
BACKUP_DIR=/srv/backups
# توقيع ملف أندرويد (Base64 لملف keystore + كلمة المرور)
APK_KEYSTORE_B64=
APK_KS_PASS=
LOG_LEVEL=INFO
