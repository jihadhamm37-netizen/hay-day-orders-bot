# ============ انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى GitHub أبداً ============

# رمز البوت من @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# رابط قاعدة PostgreSQL (في Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:password@localhost:5432/hayday

# مفاتيح سرية — أنشئها بالأمر: python -m scripts.gen_keys
# ⚠️ احتفظ بنسخة من ENCRYPTION_KEY في مكان آمن: بدونه لا يمكن فك كلمات مرور الحسابات
ENCRYPTION_KEY=
JWT_SECRET=

# Telegram User ID للمالك/المالكين (أرقام، مفصولة بفواصل) — يحصلون على قائمة الإدارة في البوت
# اعرف رقمك عبر @userinfobot
OWNER_TELEGRAM_IDS=123456789

# أول حساب للوحة التحكم (يُنشأ تلقائياً عند أول تشغيل فقط إذا لم يوجد أي مشرف)
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=ChangeMe-Strong123
# يُربط تلقائياً بأول رقم في OWNER_TELEGRAM_IDS لإرسال رمز التحقق
# INITIAL_ADMIN_TELEGRAM_ID=

# مسار سري للوحة التحكم (غيّره إلى شيء يصعب تخمينه)
ADMIN_PANEL_PATH=/panel-change-me-7f3k
PUBLIC_URL=https://your-app.up.railway.app

# all = البوت + اللوحة في خدمة واحدة | bot | api
MODE=all
PORT=8080

# أمان اللوحة
COOKIE_SECURE=true
SESSION_HOURS=12
REQUIRE_TELEGRAM_CODE=true

# النسخ الاحتياطي التلقائي (بالساعات، 0 = إيقاف) وإرسال النسخة للمالك عبر تيليجرام
BACKUP_EVERY_HOURS=24
BACKUP_TO_TELEGRAM=true
BACKUP_DIR=/srv/backups

# (اختياري) التحقق الآلي من تحويلات Binance Pay — مفتاح API بصلاحية قراءة فقط
BINANCE_API_KEY=
BINANCE_API_SECRET=

LOG_LEVEL=INFO
