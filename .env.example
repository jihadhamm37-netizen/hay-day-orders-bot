# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى GitHub أبداً.

# رمز البوت من @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# قاعدة PostgreSQL مستقلة لهذا البوت (في Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:password@localhost:5432/hdfarm

# مفاتيح سرية — أنشئها بالأمر: python -m scripts.gen_keys
# احتفظ بنسخة من ENCRYPTION_KEY في مكان آمن: بدونه لا يمكن فك Token ID وكلمات المرور
ENCRYPTION_KEY=
JWT_SECRET=

# الذكاء الاصطناعي (Claude من Anthropic). بدون المفتاح تُحوَّل كل الرسائل للإدارة.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Telegram User ID للمالك (أرقام مفصولة بفواصل) — تصله الإشعارات ورموز دخول اللوحة
OWNER_TELEGRAM_IDS=123456789

# أول حساب للوحة التحكم (يُنشأ عند أول تشغيل إذا لم يوجد أي مشرف)
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=ChangeMe-Strong123

# مسار سري للوحة التحكم
ADMIN_PANEL_PATH=/panel-change-me-7f3k
PUBLIC_URL=https://your-app.up.railway.app

# all = البوت + اللوحة في خدمة واحدة | bot | api
MODE=all
PORT=8080

COOKIE_SECURE=true
SESSION_HOURS=12
REQUIRE_TELEGRAM_CODE=true

# النسخ الاحتياطي التلقائي (بالساعات، 0 = إيقاف) وإرسال النسخة للمالك عبر تيليجرام
BACKUP_EVERY_HOURS=24
BACKUP_TO_TELEGRAM=true
BACKUP_DIR=/srv/backups

# true مرة واحدة فقط لحذف جداول البوت القديم من نفس القاعدة، ثم احذفه
RESET_DB=false

LOG_LEVEL=INFO
